# Health Connect — backend environment
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every variable below is referenced somewhere in the source; the "no default"
# ones will break something if left unset.

# ---------------------------------------------------------------------------
# Required — the server will not run without these
# ---------------------------------------------------------------------------

# MongoDB connection string. mongoose.connect() is called with this directly.
MONGO_URI=mongodb://127.0.0.1:27017/health_connect

# Secret used to sign and verify every mobile JWT. Any long random string.
# Changing it invalidates all existing sessions.
MOBILE_TOKEN=replace_with_a_long_random_secret

# ---------------------------------------------------------------------------
# Payments — DPO / PayGate
# Required for package purchases. utils/dpoPayment.js throws if either is
# missing, so initiation and verification both fail closed.
# These live here and only here — they must never go in the mobile app, where
# an EXPO_PUBLIC_ prefix would inline them into the shipped bundle.
# ---------------------------------------------------------------------------

DPO_PAYGATE_ID=your_paygate_id
DPO_ENCRYPTION_KEY=your_paygate_encryption_key

# Optional — shown with their built-in defaults.
# DPO_CURRENCY=NAD
# DPO_LOCALE=en-za
# DPO_COUNTRY=NAM
# DPO_TIME_ZONE=Africa/Windhoek
# Must match the URL the app watches for to detect the end of the payment flow.
# DPO_RETURN_URL=https://kopanovertex.com

# ---------------------------------------------------------------------------
# Video consultations — Stream.io
# Required for teleconsultation. The mobile app no longer carries the Stream
# API key: the server returns it in the /app/teleconsultation/call-access
# response, so video calls depend entirely on these being set here.
# ---------------------------------------------------------------------------

STREAM_VIDEO_API_KEY=your_stream_api_key
STREAM_VIDEO_SECRET=your_stream_secret

# ---------------------------------------------------------------------------
# SMS — OTP delivery
# Required for phone verification and password reset.
# ---------------------------------------------------------------------------

SMS_API_URL=https://your-sms-provider.example/send
SMS_API_USERNAME=your_sms_username
SMS_API_PASSWORD=your_sms_password
SMS_API_SENDERID=HealthConnect

# ---------------------------------------------------------------------------
# Push notifications — Firebase
# Path to the Firebase Admin service account JSON, relative to config/.
# If unset, config/firebase.js looks for
# ./health-connect-uat-firebase-adminsdk-fbsvc-51241b9223.json in the project
# root. If neither exists, Firebase push is silently disabled — the server
# still runs, but notifications will not be delivered.
# ---------------------------------------------------------------------------

# FIREBASE_SERVICE_ACCOUNT_PATH=../health-connect-uat-firebase-adminsdk.json

# ---------------------------------------------------------------------------
# Sessions
# Optional — shown with their built-in defaults. The app has no inactivity
# timeout and there is no refresh flow, so JWT_EXPIRES_IN alone bounds how
# long a session, or a stolen token, stays valid.
# ---------------------------------------------------------------------------

# JWT_EXPIRES_IN=12h
# APP_JWT_EXPIRES_IN=24h

# ---------------------------------------------------------------------------
# CORS origins for the admin portal / web clients
# No defaults. If left unset the allowed-origin list becomes [undefined,
# undefined, undefined] and browser requests are rejected. The mobile app is
# unaffected, since native HTTP clients do not enforce CORS.
# ---------------------------------------------------------------------------

LOCAL_HOST_1=http://localhost:3000
LOCAL_HOST_2=
LOCAL_HOST_3=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# PORT=5000
